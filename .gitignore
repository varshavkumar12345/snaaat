# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# ─── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ─── Distribution / packaging ─────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg

# ─── Jupyter ──────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ─── Data files (cache / downloads) ───────────────────────────────────────────
data/raw/*.json.gz
data/raw/*.json
data/processed/*.parquet
data/processed/*.csv
data/splits/*.pkl
data/splits/*.csv

# Keep README placeholders
!data/README.md
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/splits/.gitkeep

# ─── Output artefacts ─────────────────────────────────────────────────────────
outputs/visualizations/*.html
outputs/visualizations/*.png
outputs/visualizations/*.pdf
outputs/visualizations/*.graphml
outputs/recommendations/*.csv
outputs/reports/*.pdf
outputs/reports/*.csv
outputs/presentation/*.pptx
outputs/*.log

# Keep directory structure
!outputs/visualizations/.gitkeep
!outputs/recommendations/.gitkeep
!outputs/reports/.gitkeep
!outputs/presentation/.gitkeep

# ─── Secrets ──────────────────────────────────────────────────────────────────
.env
.env.*
secrets.yaml

# ─── IDE / editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ─── Testing / coverage ───────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml

